[{"data":1,"prerenderedAt":157},["ShallowReactive",2],{"members-\u002Fmembers\u002Fresources":3},{"id":4,"title":5,"body":6,"description":149,"extension":150,"meta":151,"navigation":152,"path":153,"seo":154,"stem":155,"__hash__":156},"members\u002Fmembers\u002Fresources.md","Member Resources",{"type":7,"value":8,"toc":132},"minimark",[9,14,18,23,26,42,45,48,52,56,59,65,69,72,86,90,93,96,98,102,106,109,122,125,129],[10,11,13],"h2",{"id":12},"performance-dress-code","Performance Dress Code",[15,16,17],"p",{},"Guidelines for what to wear during performances will be posted here closer to each concert.",[19,20,22],"h3",{"id":21},"general-guidelines","General Guidelines",[15,24,25],{},"Please ensure your performance attire is:",[27,28,29,33,36,39],"ul",{},[30,31,32],"li",{},"Clean and well-presented",[30,34,35],{},"Comfortable for singing",[30,37,38],{},"Appropriate for the venue",[30,40,41],{},"Consistent with choir guidelines provided before each performance",[15,43,44],{},"Specific requirements (colors, formal\u002Fcasual, accessories) will be communicated by email and discussed at rehearsals before each performance.",[46,47],"hr",{},[10,49,51],{"id":50},"serving-refreshments","Serving Refreshments",[19,53,55],{"id":54},"tea-break-at-rehearsals","Tea Break at Rehearsals",[15,57,58],{},"We have a tea break during our Tuesday rehearsals where hot drinks and cake are available at 50p each.",[15,60,61],{},[62,63,64],"strong",{},"Remember to bring your own cup!",[19,66,68],{"id":67},"refreshment-duty","Refreshment Duty",[15,70,71],{},"Members take turns helping to serve refreshments during the break. This involves:",[27,73,74,77,80,83],{},[30,75,76],{},"Setting up drinks",[30,78,79],{},"Serving cake",[30,81,82],{},"Taking payments (50p per item)",[30,84,85],{},"Cleaning up after the break",[19,87,89],{"id":88},"rota","Rota",[15,91,92],{},"The refreshment duty rota will be posted here and shared via email. If you're unable to make your assigned week, please swap with another member and let the committee know.",[15,94,95],{},"Thank you for helping to keep our tea breaks running smoothly!",[46,97],{},[10,99,101],{"id":100},"contact-information","Contact Information",[19,103,105],{"id":104},"committee-contact","Committee Contact",[15,107,108],{},"For internal choir matters, please use the following contacts:",[15,110,111,114,117],{},[62,112,113],{},"General Inquiries:",[115,116],"br",{},[118,119,121],"a",{"href":120},"mailto:comms@tottenhamcommunitychoir.org","comms@tottenhamcommunitychoir.org",[15,123,124],{},"Committee member contact details and specific responsibilities will be shared via email to members.",[19,126,128],{"id":127},"emergency-contacts","Emergency Contacts",[15,130,131],{},"Emergency contact information is available to members via email.",{"title":133,"searchDepth":134,"depth":134,"links":135},"",2,[136,140,145],{"id":12,"depth":134,"text":13,"children":137},[138],{"id":21,"depth":139,"text":22},3,{"id":50,"depth":134,"text":51,"children":141},[142,143,144],{"id":54,"depth":139,"text":55},{"id":67,"depth":139,"text":68},{"id":88,"depth":139,"text":89},{"id":100,"depth":134,"text":101,"children":146},[147,148],{"id":104,"depth":139,"text":105},{"id":127,"depth":139,"text":128},"Practical information for choir members","md",{"protected":152},true,"\u002Fmembers\u002Fresources",{"title":5,"description":149},"members\u002Fresources","FKJ7RacFzVljxSmJLEpc6gl6kX-w4spTzznqPiIapzg",1775297482421]